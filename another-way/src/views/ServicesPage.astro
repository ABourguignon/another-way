---
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CallToAction from '../components/CallToAction.astro';
import { site, t, routes, fill, slug, type Lang } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);
const s = c.prestations;
const r = routes[lang];

const contactLink = (p: any) =>
  `${r.contact}?objet=${p.devis ? 'devis' : 'prestation'}&prestation=${encodeURIComponent(p.nom)}`;
---

<Layout lang={lang} page="services" seoKey="prestations" overlayHeader ogImage={s.banniere.image}>
  <Banner image={s.banniere.image}
    focus={s.banniere.cadrage} alt={s.banniere.image_alt} eyebrow={s.banniere.surtitre} title={s.banniere.titre} />

  <section class="section intro">
    <div class="container">
      <p class="lead reveal">{s.intro}</p>
    </div>
  </section>

  <section class="services" aria-label={s.banniere.titre}>
    <div class="container">
      {
        s.liste.map((p: any, i: number) => (
          <article class:list={['service', { 'service--reverse': i % 2 === 1 }]} id={slug(p.nom)}>
            <div class="service__media reveal">
              <Photo name={p.image} alt={p.nom} widths={[500, 800, 1200]} sizes="(max-width: 900px) 100vw, 50vw" />
            </div>
            <div class="service__body reveal">
              <span class="service__num">{String(i + 1).padStart(2, '0')}</span>
              <h2>{p.nom}</h2>

              <div class="service__price">
                <span class="service__price-label">{s.libelle_tarif}</span>
                {p.tarifs ? (
                  <ul>
                    {p.tarifs.map((x: any) => (
                      <li>
                        <span>{x.libelle}</span>
                        <strong>{x.prix}</strong>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <strong class="service__price-value">{p.tarif}</strong>
                )}
                {p.frequence && <span class="service__freq">{p.frequence}</span>}
              </div>

              <p class="service__desc">{fill(p.description)}</p>
              {p.details && <p class="service__details">{fill(p.details)}</p>}
              {p.infos && <p class="service__infos">{fill(p.infos)}</p>}

              <a class="link-arrow" href={contactLink(p)}>
                {p.devis ? s.bouton_devis : s.bouton_reserver} <Icon name="arrow" size={16} />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--grey travel">
    <div class="container travel__inner reveal">
      <Icon name="pin" size={30} />
      <div>
        <h2>{s.deplacements.titre}</h2>
        <p>{fill(s.deplacements.texte)}</p>
        <p class="travel__vat">{s.mention_tva}</p>
      </div>
    </div>
  </section>

  <CallToAction title={s.appel.titre} text={s.appel.texte} href={`${r.contact}?objet=devis`} label={s.appel.bouton} />
</Layout>

<style>
  .intro {
    padding-bottom: 0;
  }
  .intro .lead {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.8vw, 2.3rem);
    line-height: 1.35;
    color: var(--black);
    max-width: 52rem;
  }

  .services {
    padding-block: clamp(3rem, 7vw, 6rem) var(--section);
  }
  .service {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .service + .service {
    border-top: 1px solid var(--grey-150);
  }
  .service--reverse .service__media {
    order: 2;
  }
  .service__media {
    aspect-ratio: 5 / 4;
    overflow: hidden;
  }
  .service__media :global(img),
  .service__media :global(.photo-placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .service__num {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    color: var(--grey-500);
    margin-bottom: 1rem;
  }
  .service h2 {
    font-size: clamp(2rem, 3.6vw, 3rem);
    margin-bottom: 1.6rem;
  }
  .service__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.2rem;
    padding: 1.1rem 0;
    margin-bottom: 1.6rem;
    border-block: 1px solid var(--grey-150);
  }
  .service__price-label {
    flex-basis: 100%;
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--grey-500);
  }
  .service__price-value,
  .service__price li strong {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.9rem;
    color: var(--black);
    line-height: 1.2;
  }
  .service__price ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2.2rem;
  }
  .service__price li {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }
  .service__price li span {
    font-size: 0.9rem;
    color: var(--grey-700);
  }
  .service__freq {
    font-size: 0.9rem;
    color: var(--grey-700);
  }
  .service__desc {
    font-size: 1.1rem;
    color: var(--anthracite);
  }
  .service__details,
  .service__infos {
    color: var(--grey-700);
  }
  .service .link-arrow {
    margin-top: 1.2rem;
  }

  .travel__inner {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    max-width: 52rem;
  }
  .travel__inner > :global(svg) {
    flex-shrink: 0;
    margin-top: 0.4rem;
    color: var(--black);
  }
  .travel h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin-bottom: 1rem;
  }
  .travel__vat {
    font-size: 0.85rem;
    color: var(--grey-500);
    margin-top: 1rem;
  }

  @media (max-width: 900px) {
    .service {
      grid-template-columns: 1fr;
    }
    .service--reverse .service__media {
      order: 0;
    }
  }
</style>
