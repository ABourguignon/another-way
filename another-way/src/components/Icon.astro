---
interface Props {
  name: 'instagram' | 'facebook' | 'phone' | 'mail' | 'pin' | 'arrow' | 'close' | 'prev' | 'next' | 'menu' | 'check';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" />
    </>
  )}
  {name === 'facebook' && <path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8.9v3h2.6V21" />}
  {name === 'phone' && <path d="M5 4h3.5l1.5 4.5-2 1.5a11 11 0 0 0 6 6l1.5-2 4.5 1.5V19a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4z" />}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="1" />
      <path d="m3.5 6 8.5 7 8.5-7" />
    </>
  )}
  {name === 'pin' && (
    <>
      <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </>
  )}
  {name === 'arrow' && <path d="M4 12h16m-6-6 6 6-6 6" />}
  {name === 'close' && <path d="M5 5l14 14M19 5 5 19" />}
  {name === 'prev' && <path d="m15 5-7 7 7 7" />}
  {name === 'next' && <path d="m9 5 7 7-7 7" />}
  {name === 'menu' && <path d="M3 7h18M3 12h18M3 17h18" />}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
</svg>
