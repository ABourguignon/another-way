---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { getImage } from '../lib/images';
import { getImage as optimise } from 'astro:assets';
import { isPlaceholder } from '../lib/content';

interface Props {
  images: { fichier: string; alt: string }[];
  labels: { fermer: string; precedente: string; suivante: string };
}
const { images, labels } = Astro.props;

// Large versions used in the lightbox
const items = await Promise.all(
  images.map(async (img) => {
    const src = getImage(img.fichier);
    const large = src ? await optimise({ src, width: Math.min(src.width, 2000), format: 'webp', quality: 82 }) : null;
    return { ...img, alt: isPlaceholder(img.alt) ? '' : img.alt, large: large?.src };
  }),
);
---

<div class="gallery" data-gallery>
  {
    items.map((img, i) => (
      <figure class:list={['gallery__item', 'reveal', `gallery__item--${(i % 6) + 1}`]}>
        {img.large ? (
          <button type="button" class="gallery__open" data-index={i} data-src={img.large} data-alt={img.alt} aria-label={img.alt || `Photo ${i + 1}`}>
            <Photo name={img.fichier} alt={img.alt} widths={[400, 700, 1000]} sizes="(max-width: 700px) 100vw, 33vw" />
          </button>
        ) : (
          <Photo name={img.fichier} alt={img.alt} />
        )}
      </figure>
    ))
  }
</div>

<dialog class="lightbox" data-lightbox aria-label="Galerie">
  <button type="button" class="lightbox__btn lightbox__close" data-close aria-label={labels.fermer}><Icon name="close" size={26} /></button>
  <button type="button" class="lightbox__btn lightbox__prev" data-prev aria-label={labels.precedente}><Icon name="prev" size={30} /></button>
  <img class="lightbox__img" alt="" />
  <button type="button" class="lightbox__btn lightbox__next" data-next aria-label={labels.suivante}><Icon name="next" size={30} /></button>
</dialog>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: clamp(140px, 17vw, 230px);
    gap: clamp(0.5rem, 1.2vw, 1rem);
  }
  .gallery__item {
    margin: 0;
    overflow: hidden;
    background: var(--grey-150);
  }
  .gallery__item--1 { grid-column: span 7; grid-row: span 2; }
  .gallery__item--2 { grid-column: span 5; }
  .gallery__item--3 { grid-column: span 5; }
  .gallery__item--4 { grid-column: span 4; }
  .gallery__item--5 { grid-column: span 4; }
  .gallery__item--6 { grid-column: span 4; }

  .gallery__open {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .gallery__item :global(img),
  .gallery__item :global(.photo-placeholder) {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    object-position: center 30%;
    transition:
      transform 1.1s var(--ease),
      filter 0.6s var(--ease);
  }
  .gallery__open:hover :global(img),
  .gallery__open:focus-visible :global(img) {
    transform: scale(1.045);
  }

  @media (max-width: 700px) {
    .gallery {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 44vw;
    }
    .gallery__item[class*='gallery__item--'] {
      grid-column: span 1;
      grid-row: span 1;
    }
    .gallery__item--1 {
      grid-column: span 2 !important;
      grid-row: span 2 !important;
    }
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(8, 8, 8, 0.96);
    color: var(--white);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: fade 0.35s var(--ease);
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox__img {
    max-width: min(92vw, 1600px);
    max-height: 86vh;
    object-fit: contain;
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    background: none;
    border: 0;
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    transition: color 0.3s var(--ease);
  }
  .lightbox__btn:hover {
    color: var(--white);
  }
  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }
  .lightbox__prev {
    left: 1rem;
    top: 50%;
    translate: 0 -50%;
  }
  .lightbox__next {
    right: 1rem;
    top: 50%;
    translate: 0 -50%;
  }
  @keyframes fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery] .gallery__open')];
  const img = dialog?.querySelector<HTMLImageElement>('.lightbox__img');
  let current = 0;

  const show = (i: number) => {
    if (!img || !buttons.length) return;
    current = (i + buttons.length) % buttons.length;
    img.src = buttons[current].dataset.src || '';
    img.alt = buttons[current].dataset.alt || '';
  };

  buttons.forEach((b, i) =>
    b.addEventListener('click', () => {
      show(i);
      dialog?.showModal();
    }),
  );
  dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
  dialog?.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => buttons[current]?.focus());
  dialog?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  // Swipe on touch screens
  let startX = 0;
  dialog?.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
  dialog?.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
  });
</script>
